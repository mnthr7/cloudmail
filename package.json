{
	"name": "cloudmail",
	"private": true,
	"version": "1.0.0",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/wrap-cloudflare-worker.mjs",
		"preview": "bun run build && wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"deploy:live": "bash scripts/deploy-live.sh",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:clean": "bun scripts/check-template-clean.mjs",
		"test": "bun test tests",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260601.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.2",
		"vite": "^8.3.5",
		"wrangler": "^4.157.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.6.0",
		"marked": "^18.1.3",
		"postal-mime": "^4.2.1",
		"remixicon": "^4.9.1",
		"sanitize-html": "^2.18.1",
		"tldts": "^7.5.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
